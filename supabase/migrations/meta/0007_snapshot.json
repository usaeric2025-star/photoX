      "definition": "\n  SELECT \n    p.id, \n    p.name, \n    p.description,\n    p.image_url,\n    p.group_id, \n    g.name AS group_name,\n    g.cover_photo_id AS group_cover_photo_id,\n    p.is_hidden,\n    p.is_pinned,\n    p.is_group_cover,\n    p.category_id,\n    p.manufacturer_id,\n    p.manual_code,\n    p.model_number,\n    p.item_code,\n    p.created_at,\n    COALESCE(ARRAY_AGG(t.name) FILTER (WHERE t.name IS NOT NULL), '{}') AS tags,\n    COALESCE(ARRAY_AGG(t.id) FILTER (WHERE t.id IS NOT NULL), '{}') AS tag_ids,\n    c.name_zh AS category_name_zh,\n    c.name_en AS category_name_en,\n    c.name_ms AS category_name_ms\n  FROM furniture_items p\n  LEFT JOIN groups g ON g.id = p.group_id\n  LEFT JOIN photo_tags pt ON pt.photo_id = p.id\n  LEFT JOIN tags t ON t.id = pt.tag_id\n  LEFT JOIN categories c ON c.id = p.category_id\n  GROUP BY p.id, g.id, c.id\n",
      "name": "v_photos_list",
      "schema": "public",
      "isExisting": false,
      "materialized": true
    }
