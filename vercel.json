{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/error-log", "destination": "/api/error-log" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/stats.html", "destination": "/stats.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
