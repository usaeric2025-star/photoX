{
  "name": "photoX",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "npm run lint:db && tsc --noEmit",
    "lint:db": "grep -rn 'is_hidden' src/ --include='*.ts' --include='*.tsx' && (echo '❌ 发现 is_hidden 字段名错误' && exit 1) || (echo '✅ 字段名检查通过')",
    "check-tags": "grep -rI 'from(DB_CONFIG.TABLE_NAME)' src | grep -E 'tag_ids|tagIds' && echo 'Schema Conflict Found' || echo 'No Schema Conflict Found'"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/geist": "^5.2.8",
    "@google/genai": "^1.50.1",
    "@supabase/supabase-js": "^2.104.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.2",
    "react-virtuoso": "^4.18.6",
    "spark-md5": "^3.0.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "yet-another-react-lightbox": "^3.32.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  }
}
