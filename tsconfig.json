{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node", "vite/client"],
    "strict": false,
    "noImplicitAny": false,
    "paths": {
      "#shared/*": ["./shared/*"],
      "#api/*": ["./api/*"],
      "#src/*": ["./src/*"],
      "#lib/*": ["./src/lib/*"]
    },
    "rootDir": "./",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noImplicitOverride": true,
    "outDir": "./dist"
  },
  "include": ["src/**/*", "shared/**/*", "api/**/*"],
  "exclude": ["node_modules", "dist"]
}
