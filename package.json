{
  "name": "photoX",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "imports": {
    "#shared/*": "./shared/*",
    "#api/*": "./api/*",
    "#src/*": "./src/*",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "check-imports": "node scripts/check-imports.js",
    "dev": "tsx server.ts",
    "build": "npm run check-imports && vite build && npx esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "vercel-build": "npm run build",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "analyze": "vite build --mode analyze",
    "lint": "tsc --noEmit && bash scripts/check-imports.sh",
    "knip": "knip",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "storage:audit": "npx tsx scripts/storage/auditR2.ts",
    "storage:clean": "npx tsx scripts/storage/cleanOrphans.ts",
    "check:schema-compat": "npx tsx scripts/schema-compat-check.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*(src|api)/**/*.{ts,tsx}": [
      "node scripts/check-imports.js"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "@hono/node-server": "^2.0.8",
    "@hono/standard-validator": "^0.2.3",
    "@preact/signals-react": "^3.10.2",
    "@supabase/supabase-js": "^2.110.0",
    "@tanstack/query-async-storage-persister": "^5.101.2",
    "@tanstack/query-core": "^5.101.2",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-persist-client": "^5.101.2",
    "@tanstack/valibot-form-adapter": "0.42.1",
    "@vercel/analytics": "2.0.1",
    "browser-image-compression": "2.0.2",
    "clsx": "^2.1.1",
    "dayjs": "1.11.21",
    "dream-masonry": "^0.1.2",
    "drizzle-orm": "0.45.2",
    "hono": "^4.12.27",
    "idb-keyval": "^6.2.6",
    "lite-sleek": "1.1.0",
    "lucide-react": "^1.23.0",
    "nuqs": "^2.9.0",
    "postgres": "3.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "valibot": "^1.4.2",
    "wouter": "^3.10.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "4.1.9",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "jsdom": "29.1.1",
    "knip": "^6.24.0",
    "lint-staged": "^17.0.8",
    "rollup-plugin-visualizer": "7.0.1",
    "tailwindcss": "^4.3.2",
    "terser": "^5.48.0",
    "tsx": "^4.23.0",
    "typescript": "6.0.3",
    "vite": "^8.1.3",
    "vitest": "4.1.9"
  }
}
