{
  "name": "photoX",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "icons:generate": "npx tsx scripts/generate-icons-wrapper.js",
    "dev": "npm run icons:generate && tsx server.ts",
    "build": "npm run icons:generate && vite build",
    "vercel-build": "npm run icons:generate && tsgo --noEmit && vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "analyze": "vite build --mode analyze",
    "lint": "tsgo --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "storage:audit": "npx tsx scripts/storage/auditR2.ts",
    "storage:clean": "npx tsx scripts/storage/cleanOrphans.ts",
    "check:schema-compat": "npx tsx scripts/schema-compat-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1066.0",
    "@aws-sdk/s3-request-presigner": "^3.1066.0",
    "@hono/node-server": "^2.0.4",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.101.0",
    "@vercel/analytics": "^1.3.0",
    "@zoontek/chicane": "^3.0.0",
    "arktype": "^2.2.0",
    "clsx": "^2.1.0",
    "dayjs": "^1.11.21",
    "drizzle-orm": "^0.45.2",
    "el-form-react-components": "^4.8.0",
    "el-form-react-hooks": "^3.16.0",
    "hono": "^4.12.26",
    "lucide-react-sprite": "^2.2.1",
    "postgres": "^3.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-error-boundary": "^6.1.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.1",
    "virtua": "^0.49.1",
    "yet-another-react-lightbox": "^3.32.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/uuid": "^10.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20260421.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.9",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^16.4.0",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "knip": "^6.17.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
