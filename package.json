    "motion": "^12.23.24",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.14.2",
    "react-virtuoso": "^4.18.6",
    "sonner": "^2.0.7",
    "spark-md5": "^3.0.2",
    "tailwind-merge": "^3.5.0",
