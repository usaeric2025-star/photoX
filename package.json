{
  "name": "photoX",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "icons:generate": "npx tsx scripts/generate-icons-wrapper.js",
    "dev": "npm run icons:generate && tsx server.ts",
    "build": "npm run icons:generate && vite build",
    "vercel-build": "npm run icons:generate && tsgo --noEmit && vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "analyze": "vite build --mode analyze",
    "lint": "tsgo --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "storage:audit": "npx tsx scripts/storage/auditR2.ts",
    "storage:clean": "npx tsx scripts/storage/cleanOrphans.ts",
    "check:schema-compat": "npx tsx scripts/schema-compat-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1066.0",
    "@aws-sdk/s3-request-presigner": "^3.1066.0",
    "@hono/node-server": "^2.0.4",
    "@hono/valibot-validator": "^0.6.1",
    "@mshafiqyajid/react-lightbox": "^0.1.0",
    "@storve/core": "^1.1.5",
    "@storve/react": "^1.1.7",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/valibot-form-adapter": "^0.42.1",
    "@vercel/analytics": "^1.3.0",
    "@zoontek/chicane": "^3.0.0",
    "clsx": "^2.1.0",
    "dayjs": "^1.11.21",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.26",
    "lucide-react-sprite": "^2.2.1",
    "motion": "^12.41.0",
    "postgres": "^3.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-error-boundary": "^6.1.2",
    "sonner": "^2.0.7",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.6.0",
    "valibot": "^1.4.1",
    "virtua": "^0.49.1"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
