{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "api/index.ts",
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "api/**/*.{ts,tsx}",
    "shared/**/*.ts"
  ],
  "ignoreDependencies": [
    "@tanstack/query-core"
  ],
  "rules": {
    "files": "warn",
    "exports": "warn",
    "types": "warn",
    "nsExports": "warn",
    "nsTypes": "warn",
    "enumMembers": "warn",
    "duplicates": "warn"
  }
}
